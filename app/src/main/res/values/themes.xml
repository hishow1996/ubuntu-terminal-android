<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.UbuntuTerminal" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/ubuntu_orange</item>
        <item name="colorPrimaryVariant">@color/ubuntu_aubergine</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ubuntu_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/terminal_bg</item>
        <item name="android:colorBackground">@color/terminal_bg</item>
        <item name="android:textColorPrimary">@color/terminal_fg</item>
        <item name="android:textColorSecondary">@color/terminal_fg_dim</item>
        <item name="android:statusBarColor">@color/terminal_bg_dark</item>
        <item name="android:navigationBarColor">@color/terminal_bg_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Splash theme (no action bar, immersive) -->
    <style name="Theme.UbuntuTerminal.Splash" parent="Theme.UbuntuTerminal">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>
</resources>
